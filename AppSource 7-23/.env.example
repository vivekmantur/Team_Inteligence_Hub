# Microsoft Entra ID (app registration -> Overview)
# Copy this file to .env.local and fill in your values.

# Application (client) ID
VITE_ENTRA_CLIENT_ID=

# Directory (tenant) ID. Use "organizations" for any work account,
# or "common" to also allow personal Microsoft accounts.
VITE_ENTRA_TENANT_ID=

# Optional: full authority URL. Required for Entra External ID (CIAM) tenants, e.g.
# https://<tenant-name>.ciamlogin.com/<tenant-id>
VITE_ENTRA_AUTHORITY=

# Optional: overrides the redirect URI. Defaults to the directory the app is served from.
# Must be registered in the app registration under Authentication -> Single-page application.
VITE_ENTRA_REDIRECT_URI=

# Optional: set to "true" to show the "Create an account" button on the login page.
# Only works when self-service sign-up is enabled on the tenant (Entra External ID).
VITE_ENTRA_SIGNUP_ENABLED=false

# Scope exposed by TeamIntelligenceHub.API, e.g. api://<api-client-id>/access_as_user
VITE_ENTRA_API_SCOPE=

# Base URL of TeamIntelligenceHub.API. Must also appear in the API's Cors:AllowedOrigins
# counterpart -- the API needs this app's origin, this app needs the API's.
VITE_API_BASE_URL=http://localhost:5103
